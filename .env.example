# Dolce Fiore - Environment Variables Example
# Copy this file to .env and fill in the actual values
# Never commit the .env file to version control!

# ============================================
# Django Settings
# ============================================

# Django Secret Key (generate a new one for production!)
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Django Environment (development or production)
# This determines which settings file to use
DJANGO_ENV=production

# Debug Mode (True for development, False for production)
DEBUG=False

# Allowed Hosts (comma-separated list)
# For production, include your domain: yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ============================================
# Database Configuration (PostgreSQL)
# ============================================

# Database name
DB_NAME=dolce_db

# Database user
DB_USER=dolce_user

# Database password (use a strong password in production!)
DB_PASSWORD=changeme-strong-password-here

# Database host (use 'db' for Docker, 'localhost' for native)
DB_HOST=db

# Database port
DB_PORT=5432

# ============================================
# CORS Configuration
# ============================================

# CORS Allowed Origins (comma-separated list)
# For production, include your frontend URL: https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# ============================================
# Security Settings (Production)
# ============================================

# SSL Redirect (True for production with HTTPS)
SECURE_SSL_REDIRECT=True

# ============================================
# Logging
# ============================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# Email Configuration (Optional)
# ============================================

# Email Backend (for sending emails)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Host
EMAIL_HOST=smtp.gmail.com

# SMTP Port
EMAIL_PORT=587

# Use TLS
EMAIL_USE_TLS=True

# SMTP User (your email)
EMAIL_HOST_USER=your-email@gmail.com

# SMTP Password (app password for Gmail)
EMAIL_HOST_PASSWORD=your-app-password

# Default From Email
DEFAULT_FROM_EMAIL=noreply@dolcefiore.com

# ============================================
# Frontend Configuration
# ============================================

# API Base URL for frontend (usually not needed as it uses relative paths)
# VITE_API_BASE_URL=

# ============================================
# On-Demand Revalidation (ISR)
# ============================================
# Secret token for authenticating revalidation requests between Django and Next.js
# Generate a secure random string: openssl rand -base64 32
# When content is updated in Django admin, it triggers Next.js to refresh the cached page
REVALIDATION_SECRET=your-secure-revalidation-secret-change-this

# ============================================
# AWS S3 Storage (Media uploads only)
# ============================================
#
# When enabled, Django will upload media files to S3.
# Media files (user uploads) go to: s3://AWS_STORAGE_BUCKET_NAME/media/
#
# Note: Next.js static files are served directly by Next.js container.
# CloudFront caches them at the edge - no S3 needed for /_next/static/*.
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================
# CloudFront Configuration
# ============================================
#
# When using CloudFront, set this to your CloudFront distribution domain.
# Used for serving media files through CloudFront.
# Example: d1234567890.cloudfront.net
AWS_S3_CUSTOM_DOMAIN=
CLOUDFRONT_DOMAIN=

# CloudFront mode: Nginx disabled, CloudFront handles SSL termination
CLOUDFRONT_MODE=false

# ============================================
# Notes
# ============================================
#
# For Development:
# - Set DJANGO_ENV=development
# - Set DEBUG=True
# - Set ALLOWED_HOSTS=localhost,127.0.0.1
# - Set CORS_ALLOWED_ORIGINS=http://localhost:5173
# - DB_HOST can be 'localhost' or 'db' depending on setup
#
# For Production (CloudFront + Lightsail):
# - Set DJANGO_ENV=production
# - Set DEBUG=False
# - Set ALLOWED_HOSTS to your actual domain
# - Set CORS_ALLOWED_ORIGINS to your frontend URL
# - Use strong passwords for SECRET_KEY and DB_PASSWORD
# - Set CLOUDFRONT_MODE=true (Nginx HTTP only, CloudFront handles SSL)
# - Set USE_S3=True and configure S3 bucket
# - Set AWS_S3_CUSTOM_DOMAIN to your CloudFront domain
#
# Staging Environment (kakshaonline.com):
# - ALLOWED_HOSTS=kakshaonline.com,www.kakshaonline.com
# - CORS_ALLOWED_ORIGINS=https://kakshaonline.com,https://www.kakshaonline.com
# - AWS_STORAGE_BUCKET_NAME=dolce-staging-assets
# - NGINX_DOMAIN=kakshaonline.com
# - NGINX_DOMAIN_WWW=www.kakshaonline.com
#
# Production Environment (dolcefiore.in):
# - ALLOWED_HOSTS=dolcefiore.in,www.dolcefiore.in
# - CORS_ALLOWED_ORIGINS=https://dolcefiore.in,https://www.dolcefiore.in
# - AWS_STORAGE_BUCKET_NAME=dolce-prod-assets
# - NGINX_DOMAIN=dolcefiore.in
# - NGINX_DOMAIN_WWW=www.dolcefiore.in

# Payment Gateway Env
# RAZORPAY Payment Provider
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Domain configuration (required for dev and prod)
NGINX_DOMAIN=yourdomain.com
NGINX_DOMAIN_WWW=www.yourdomain.com

# SSL certificate paths (optional - defaults shown)
NGINX_SSL_CERT_PATH=/etc/nginx/ssl/fullchain.pem
NGINX_SSL_KEY_PATH=/etc/nginx/ssl/privkey.pem

# Or use Let's Encrypt paths directly:
# NGINX_SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# NGINX_SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem