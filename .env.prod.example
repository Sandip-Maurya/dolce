# Production Environment Configuration (dolcefiore.in)
# Copy this file to .env on your production Lightsail instance and fill in actual values

# ============================================
# Django Settings
# ============================================
SECRET_KEY=generate-a-different-secure-key-here
DJANGO_ENV=production
DEBUG=False
ALLOWED_HOSTS=dolcefiore.in,www.dolcefiore.in

# ============================================
# Database Configuration
# ============================================
DB_NAME=dolce_db
DB_USER=dolce_user
DB_PASSWORD=different-strong-password-here
DB_HOST=db
DB_PORT=5432

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=https://dolcefiore.in,https://www.dolcefiore.in

# ============================================
# Security Settings
# ============================================
# CloudFront handles SSL, so we don't redirect at Django level
SECURE_SSL_REDIRECT=False

# ============================================
# AWS S3 Storage (Media uploads only)
# ============================================
# S3 is used ONLY for user-uploaded media files (images, etc.)
# Next.js static files are served directly by the Next.js container
USE_S3=True
AWS_STORAGE_BUCKET_NAME=dolce-prod-assets
AWS_S3_REGION_NAME=ap-south-1
# CloudFront domain for serving media files
AWS_S3_CUSTOM_DOMAIN=YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
# If NOT using IAM instance role, set these:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# CloudFront Configuration
# ============================================
CLOUDFRONT_DOMAIN=YOUR_CLOUDFRONT_DOMAIN.cloudfront.net
CLOUDFRONT_MODE=true

# ============================================
# Nginx Configuration (CloudFront mode)
# ============================================
NGINX_DOMAIN=dolcefiore.in
NGINX_DOMAIN_WWW=www.dolcefiore.in

# ============================================
# Revalidation Secret (ISR)
# ============================================
REVALIDATION_SECRET=different-secure-secret-here

# ============================================
# Payment Gateway (Razorpay) - LIVE KEYS
# ============================================
RAZORPAY_KEY_ID=your_live_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_live_webhook_secret

# ============================================
# Logging
# ============================================
LOG_LEVEL=WARNING
