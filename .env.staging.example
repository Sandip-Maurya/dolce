# Staging Environment Configuration (kakshaonline.com)
# Copy this file to .env on your staging Lightsail instance and fill in actual values

# ============================================
# Django Settings
# ============================================
SECRET_KEY=generate-a-secure-key-here
DJANGO_ENV=production
DEBUG=False
ALLOWED_HOSTS=kakshaonline.com,www.kakshaonline.com

# ============================================
# Database Configuration
# ============================================
DB_NAME=dolce_db
DB_USER=dolce_user
DB_PASSWORD=strong-password-here
DB_HOST=db
DB_PORT=5432

# ============================================
# CORS Configuration
# ============================================
CORS_ALLOWED_ORIGINS=https://kakshaonline.com,https://www.kakshaonline.com

# ============================================
# Security Settings
# ============================================
# CloudFront handles SSL, so we don't redirect at Django level
SECURE_SSL_REDIRECT=False

# ============================================
# AWS S3 Storage
# ============================================
USE_S3=True
AWS_STORAGE_BUCKET_NAME=dolce-staging-assets
AWS_S3_REGION_NAME=ap-south-1
# If NOT using IAM instance role, uncomment and set these:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================
# CloudFront Configuration
# ============================================
# Replace with your actual CloudFront distribution domain
AWS_S3_CUSTOM_DOMAIN=d1234567890.cloudfront.net
CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net
CLOUDFRONT_MODE=true

# ============================================
# Nginx Configuration (CloudFront mode)
# ============================================
NGINX_DOMAIN=kakshaonline.com
NGINX_DOMAIN_WWW=www.kakshaonline.com

# ============================================
# Revalidation Secret (ISR)
# ============================================
REVALIDATION_SECRET=generate-secure-secret-here

# ============================================
# Payment Gateway (Razorpay)
# ============================================
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
